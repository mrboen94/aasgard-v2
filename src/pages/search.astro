---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Field from "../components/ui/Field.astro";
import InlineMeta from "../components/ui/InlineMeta.astro";
import Input from "../components/ui/Input.astro";
import PageIntro from "../components/ui/PageIntro.astro";
import PageSection from "../components/ui/PageSection.astro";
---

<BaseLayout title="Search" description="Search the static site.">
  <PageSection>
    <PageIntro eyebrow="Pagefind" title="Search" />
    <div id="search" class="grid max-w-prose gap-4">
      <Field for="pagefind-search-input">
        <span>Search query</span>
        <Input
          id="pagefind-search-input"
          data-pagefind-search-input
          name="q"
          type="search"
          variant="field-lg"
        />
      </Field>
      <InlineMeta as="p" class="m-0 max-w-section-copy" data-pagefind-status layout="none"></InlineMeta>
      <div class="grid gap-4" data-pagefind-results></div>
    </div>
  </PageSection>
  <script>
    import { mountOnAstroPageLoad } from "../lib/dom/lifecycle";
    import { mountPagefindSearch } from "../lib/search/pagefind";

    mountOnAstroPageLoad(mountPagefindSearch);
  </script>
</BaseLayout>
