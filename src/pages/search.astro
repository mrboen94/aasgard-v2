---
import BaseLayout from "../components/layout/BaseLayout.astro";
---

<BaseLayout title="Search" description="Search the static site.">
  <section class="container search-page">
    <header class="search-page__header">
      <p class="eyebrow">Pagefind</p>
      <h1>Search</h1>
      <p>Static search becomes available after a production build has generated the Pagefind index.</p>
    </header>
    <div id="search"></div>
  </section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if ("PagefindUI" in window) {
        new window.PagefindUI({ element: "#search", showSubResults: true });
      }
    });
  </script>
</BaseLayout>

<style>
  .search-page {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .search-page__header {
    display: grid;
    gap: var(--space-3);
  }

  .search-page__header p {
    color: var(--color-muted);
    margin: 0;
    max-width: 44rem;
  }

  .search-page__header .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
  }
</style>
