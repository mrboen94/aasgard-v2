---
import BaseLayout from "../components/layout/BaseLayout.astro";
import PageIntro from "../components/ui/PageIntro.astro";
import PageSection from "../components/ui/PageSection.astro";
---

<BaseLayout title="Search" description="Search the static site.">
  <PageSection>
    <PageIntro eyebrow="Pagefind" title="Search" />
    <div id="search" class="grid max-w-prose gap-4">
      <label class="grid gap-2 font-accent text-small text-muted" for="pagefind-search-input">
        <span>Search query</span>
        <input
          id="pagefind-search-input"
          class="w-full rounded-card border border-border bg-surface px-4 py-3 font-main text-base text-foreground shadow-none outline-none transition-[background-color,border-color,box-shadow,color] duration-[var(--duration-fast)] ease-theme focus:border-primary focus:shadow-[var(--focus-ring)]"
          data-pagefind-search-input
          name="q"
          type="search"
        />
      </label>
      <p class="m-0 max-w-section-copy font-accent text-small text-muted" data-pagefind-status></p>
      <div class="grid gap-4" data-pagefind-results></div>
    </div>
  </PageSection>
  <script>
    import { mountOnAstroPageLoad } from "../lib/dom/lifecycle";
    import { mountPagefindSearch } from "../lib/search/pagefind";

    mountOnAstroPageLoad(mountPagefindSearch);
  </script>
</BaseLayout>
