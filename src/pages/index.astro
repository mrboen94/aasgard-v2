---
import ArticleList from "../components/article/ArticleList.astro";
import TechIconList from "../components/icons/TechIconList.astro";
import Section from "../components/layout/Section.astro";
import BaseLayout from "../components/layout/BaseLayout.astro";
import ProjectGrid from "../components/project/ProjectGrid.astro";
import Badge from "../components/ui/Badge.astro";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import Grid from "../components/ui/Grid.astro";
import MediaPlaceholder from "../components/ui/MediaPlaceholder.astro";
import {
  getArticles,
  getExperiments,
  getPhotoProjects,
  getVideoProjects,
  getWorkEntries
} from "../lib/content/collections";
import { labUrl, photoProjectUrl, videoProjectUrl } from "../lib/content/urls";

const [articles, experiments, workEntries, photoProjects, videoProjects] = await Promise.all([
  getArticles(),
  getExperiments(),
  getWorkEntries(),
  getPhotoProjects(),
  getVideoProjects()
]);
---

<BaseLayout>
  <Container class="grid gap-4">
    <section class="grid gap-4 pt-12 pb-4">
      <Badge textCase="uppercase" variant="text">Mathias Bøe</Badge>
      <p class="m-0 max-w-section-copy text-home-lead text-muted">
				Notes from an unreasonable number of side quests.
				Photography and videos, 3D modelling, data viz, prototypes and experiments, devnotes and the general overflow of a curious mind.
				Pick a thread and pull.
      </p>
    </section>

    <Section
      title="Scribbles and thoughts"
      description="Some of my notes and writing on various topics and various depths. Some are more polished than others, but all are written with the intention of sharing and exploring ideas."
      href="/articles/"
    >
      <ArticleList entries={articles.slice(0, 3)} />
    </Section>

    <Section
      title="The Lab"
      description="Experiments and prototypes are the playground of ideas, where concepts are tested, iterated upon, and sometimes discarded. They are the messy, exciting middle ground between thought and polished work."
      href="/lab/"
    >
      <Grid>
        {
          experiments.slice(0, 3).map((entry) => (
            <Card accent="success" layout="stack" padding="md">
              <a class="grid gap-2 text-inherit no-underline" href={labUrl(entry.data.slug)}>
                <Badge color="var(--card-accent)" textCase="uppercase" variant="text">
                  {entry.data.status}
                </Badge>
                <h3>{entry.data.title}</h3>
                <p class="m-0 text-muted">{entry.data.description}</p>
              </a>
              <TechIconList technologies={entry.data.technologies} />
            </Card>
          ))
        }
      </Grid>
    </Section>

    <Section
      title="Work and projects"
      description="A selection of projects I've worked on, both professionally and personally. These are the more polished and complete works, often with a focus on design, development, and problem-solving."
      href="/work/"
    >
      <ProjectGrid entries={workEntries.slice(0, 3)} />
    </Section>

    {photoProjects.length > 0 && (
      <Section
        title="Photography"
        description="Just some of my photos and collections."
        href="/photography/"
    >
      <Grid>
        {
          photoProjects.slice(0, 3).map((entry) => (
            <Card class="group" variant="flush">
              <a class="grid text-inherit no-underline" href={photoProjectUrl(entry.data.slug)}>
                <MediaPlaceholder
                  class="aspect-[4/3] transition-[background-color,transform] duration-[var(--duration-theme)] ease-theme group-hover:scale-[1.015] group-focus-within:scale-[1.015]"
                  aria-hidden="true"
                />
                <span class="grid gap-2 p-4">
                  <h3>{entry.data.title}</h3>
                  <p class="m-0 text-muted">{entry.data.description}</p>
                </span>
              </a>
            </Card>
          ))
        }
      </Grid>
    </Section>
    )}

    {videoProjects.length > 0 && (
      <Section
        title="Videography"
        description="A selection of my video and visual projects."
        href="/video/"
      >
        <Grid>
          {
            videoProjects.slice(0, 3).map((entry) => (
              <Card class="group" variant="flush">
                <a class="grid text-inherit no-underline" href={videoProjectUrl(entry.data.slug)}>
                  <MediaPlaceholder
                    class="aspect-video transition-[background-color,transform] duration-[var(--duration-theme)] ease-theme group-hover:scale-[1.015] group-focus-within:scale-[1.015]"
                    aria-hidden="true"
                  />
                  <span class="grid gap-2 p-4">
                    <h3>{entry.data.title}</h3>
                    <p class="m-0 text-muted">{entry.data.description}</p>
                  </span>
                </a>
              </Card>
            ))
          }
        </Grid>
      </Section>
    )}
  </Container>
</BaseLayout>
