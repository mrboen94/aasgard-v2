---
import { render } from "astro:content";
import ArticleMeta from "../../components/article/ArticleMeta.astro";
import ArticleProse from "../../components/article/ArticleProse.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PhotoGrid from "../../components/media/PhotoGrid.astro";
import ArticleShell from "../../components/ui/ArticleShell.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import { getPhotoProjects } from "../../lib/content/collections";

export async function getStaticPaths() {
  const entries = await getPhotoProjects();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/photography/${entry.data.slug}/`}>
  <ArticleShell class="grid gap-6 py-12" data-pagefind-body>
    <PageIntro
      class="gap-4"
      eyebrow="Photography"
      title={entry.data.title}
      titlePagefind
      description={entry.data.description}
    >
      <ArticleMeta date={entry.data.date} section="photography" />
      <dl class="m-0 flex flex-wrap gap-3">
        {entry.data.camera && <><dt class="m-0 font-accent text-muted">Camera</dt><dd class="m-0">{entry.data.camera}</dd></>}
        {entry.data.location && <><dt class="m-0 font-accent text-muted">Location</dt><dd class="m-0">{entry.data.location}</dd></>}
      </dl>
    </PageIntro>
    <PhotoGrid />
    <ArticleProse>
      <Content />
    </ArticleProse>
  </ArticleShell>
</BaseLayout>
