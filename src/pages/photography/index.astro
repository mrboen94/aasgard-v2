---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PhotoProjectCard from "../../components/media/PhotoProjectCard.astro";
import Grid from "../../components/ui/Grid.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import PageSection from "../../components/ui/PageSection.astro";
import { getPhotoProjects } from "../../lib/content/collections";

const entries = await getPhotoProjects();
---

<BaseLayout title="Photography" description="My photography projects and image essays.">
  <PageSection>
    <PageIntro
      eyebrow="Images"
      title="Photography"
      description="My photography projects and image essays."
    />
    <Grid>
      {entries.map((entry) => <PhotoProjectCard entry={entry} />)}
    </Grid>
  </PageSection>
</BaseLayout>
