---
import ArticleList from "../../components/article/ArticleList.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import PageSection from "../../components/ui/PageSection.astro";
import { getArticles } from "../../lib/content/collections";

const articles = await getArticles();
---

<BaseLayout title="Articles" description="Some of my thoughts, notes, and technical writeups on various topics.">
  <PageSection>
    <PageIntro
      eyebrow="Writing"
      title="Articles"
      description="Some of my thoughts, notes, and technical writeups on various topics."
    />
    <ArticleList entries={articles} />
  </PageSection>
</BaseLayout>
