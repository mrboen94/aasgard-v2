---
import { render } from "astro:content";
import ArticleTemplate from "../../components/article/ArticleTemplate.astro";
import InteractiveArticleTemplate from "../../components/article/InteractiveArticleTemplate.astro";
import TechnicalArticleTemplate from "../../components/article/TechnicalArticleTemplate.astro";
import { getArticles } from "../../lib/content/collections";

export async function getStaticPaths() {
  const articles = await getArticles();

  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

{
  entry.data.template === "technical" ? (
    <TechnicalArticleTemplate entry={entry} Content={Content} headings={headings} />
  ) : entry.data.template === "interactive" ? (
    <InteractiveArticleTemplate entry={entry} Content={Content} />
  ) : (
    <ArticleTemplate entry={entry} Content={Content} />
  )
}
