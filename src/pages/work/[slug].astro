---
import { render } from "astro:content";
import ArticleMeta from "../../components/article/ArticleMeta.astro";
import ArticleProse from "../../components/article/ArticleProse.astro";
import TechIconList from "../../components/icons/TechIconList.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { getWorkEntries } from "../../lib/content/collections";

export async function getStaticPaths() {
  const entries = await getWorkEntries();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/work/${entry.data.slug}/`}>
  <article class="container detail-page" data-pagefind-body>
    <header class="detail-page__header">
      <p class="eyebrow">Work</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <ArticleMeta date={entry.data.date} section="work" />
      <TechIconList technologies={entry.data.technologies} showLabels />
      {entry.data.link && <a href={entry.data.link.href}>{entry.data.link.label}</a>}
    </header>
    <ArticleProse>
      <Content />
    </ArticleProse>
  </article>
</BaseLayout>

<style>
  .detail-page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .detail-page__header {
    display: grid;
    gap: var(--space-4);
  }

  .detail-page__header p {
    color: var(--color-muted);
    margin: 0;
    max-width: 44rem;
  }

  .detail-page__header .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
  }
</style>
