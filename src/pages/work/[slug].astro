---
import { render } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import IconList from "../../components/ui/icons/IconList.astro";
import ContentShell from "../../components/ui/layout/ContentShell.astro";
import MetaList from "../../components/ui/metadata/MetaList.astro";
import PageIntro from "../../components/ui/typography/PageIntro.astro";
import Prose from "../../components/ui/typography/Prose.astro";
import { getWorkEntries } from "../../lib/content/collections";
import { resolveTechnologyItems } from "../../lib/icons/resolveTechnology";

export async function getStaticPaths() {
  const entries = await getWorkEntries();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const technologyItems = resolveTechnologyItems(entry.data.technologies);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/work/${entry.data.slug}/`}>
  <ContentShell class="grid gap-6 py-12" data-pagefind-body>
    <PageIntro
      class="gap-4"
      eyebrow="Work"
      title={entry.data.title}
      titlePagefind
      description={entry.data.description}
    >
      <MetaList date={entry.data.date} section="work" />
      <IconList items={technologyItems} showLabels />
      {entry.data.link && <a href={entry.data.link.href}>{entry.data.link.label}</a>}
    </PageIntro>
    <Prose>
      <Content />
    </Prose>
  </ContentShell>
</BaseLayout>
