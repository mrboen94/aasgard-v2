---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ProjectGrid from "../../components/project/ProjectGrid.astro";
import { getWorkEntries } from "../../lib/content/collections";

const entries = await getWorkEntries();
---

<BaseLayout title="Work" description="Projects, collaborations, and experience.">
  <section class="container page-section">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Work</h1>
      <p>Project cards render local logos and technology icons from structured content.</p>
    </header>
    <ProjectGrid entries={entries} />
  </section>
</BaseLayout>

<style>
  .page-section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .page-header {
    display: grid;
    gap: var(--space-3);
  }

  .page-header p {
    color: var(--color-muted);
    margin: 0;
    max-width: 44rem;
  }

  .page-header .eyebrow {
    color: var(--color-accent);
    text-transform: uppercase;
  }
</style>
