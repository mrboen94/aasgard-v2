---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ProjectGrid from "../../components/project/ProjectGrid.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import PageSection from "../../components/ui/PageSection.astro";
import { getWorkEntries } from "../../lib/content/collections";

const entries = await getWorkEntries();
---

<BaseLayout title="Work" description="Some of my projects, collaborations, and professional experience.">
  <PageSection>
    <PageIntro
      eyebrow="Projects"
      title="Work"
      description="Some of my projects, collaborations, and professional experience."
    />
    <ProjectGrid entries={entries} />
  </PageSection>
</BaseLayout>
