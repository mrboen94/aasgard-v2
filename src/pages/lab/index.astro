---
import ExperimentCard from "../../components/lab/ExperimentCard.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Grid from "../../components/ui/Grid.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import PageSection from "../../components/ui/PageSection.astro";
import { getExperiments } from "../../lib/content/collections";

const experiments = await getExperiments();
---

<BaseLayout title="Bøe's Lab" description="Some of my experiments, prototypes, and playful projects.">
  <PageSection>
    <PageIntro
      eyebrow="Experiments"
      title="Bøe's Lab"
      description="Some of my experiments, prototypes, and playful projects."
      secondary
    />
    <Grid>
      {experiments.map((entry) => <ExperimentCard entry={entry} />)}
    </Grid>
  </PageSection>
</BaseLayout>
