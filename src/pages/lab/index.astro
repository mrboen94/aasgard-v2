---
import ExperimentCard from "../../components/lab/ExperimentCard.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { getExperiments } from "../../lib/content/collections";

const experiments = await getExperiments();
---

<BaseLayout title="Lab" description="Experiments, games, and prototypes.">
  <section class="container page-section">
    <header class="page-header page-header--secondary">
      <p class="eyebrow">Experiments</p>
      <h1>Lab</h1>
      <p>Lab entries show prototypes directly. Articles can explain them later.</p>
    </header>
    <div class="grid">
      {experiments.map((entry) => <ExperimentCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
