---
import ExperimentCard from "../../components/lab/ExperimentCard.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { getExperiments } from "../../lib/content/collections";
import {
  eyebrowClass,
  gridClass,
  pageIntroClass,
  pageIntroCopyClass,
  pageIntroSecondaryClass,
  pageSectionClass
} from "../../lib/styles/classes";

const experiments = await getExperiments();
---

<BaseLayout title="Bøe's Lab" description="Some of my experiments, prototypes, and playful projects.">
  <section class={pageSectionClass}>
    <header class:list={[pageIntroClass, pageIntroSecondaryClass]}>
      <p class={eyebrowClass}>Experiments</p>
      <h1>Bøe's Lab</h1>
      <p class={pageIntroCopyClass}>Some of my experiments, prototypes, and playful projects.</p>
    </header>
    <div class={gridClass}>
      {experiments.map((entry) => <ExperimentCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
