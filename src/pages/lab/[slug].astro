---
import { render } from "astro:content";
import ArticleMeta from "../../components/article/ArticleMeta.astro";
import ArticleProse from "../../components/article/ArticleProse.astro";
import TechIconList from "../../components/icons/TechIconList.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import { getExperiments } from "../../lib/content/collections";

export async function getStaticPaths() {
  const entries = await getExperiments();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/lab/${entry.data.slug}/`}>
  <article class="container detail-page" data-pagefind-body>
    <header class="detail-page__header">
      <a class="detail-page__back" href="/lab/">Back to Lab</a>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <ArticleMeta date={entry.data.date} section="lab" />
      <TechIconList technologies={entry.data.technologies} showLabels />
    </header>
    <ArticleProse wide>
      <Content />
    </ArticleProse>
  </article>
</BaseLayout>

<style>
  .detail-page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  .detail-page__header {
    display: grid;
    gap: var(--space-4);
  }

  .detail-page__header p {
    color: var(--color-muted);
    margin: 0;
    max-width: 44rem;
  }

  .detail-page__back {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    color: var(--color-link);
    font-family: var(--font-accent);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .detail-page__back:focus-visible {
    clip: auto;
    clip-path: none;
    height: auto;
    overflow: visible;
    position: static;
    white-space: normal;
    width: fit-content;
  }
</style>
