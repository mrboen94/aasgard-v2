---
import { render } from "astro:content";
import ArticleMeta from "../../components/article/ArticleMeta.astro";
import ArticleProse from "../../components/article/ArticleProse.astro";
import TechIconList from "../../components/icons/TechIconList.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ArticleShell from "../../components/ui/ArticleShell.astro";
import VisuallyHidden from "../../components/ui/VisuallyHidden.astro";
import { getExperiments } from "../../lib/content/collections";

export async function getStaticPaths() {
  const entries = await getExperiments();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/lab/${entry.data.slug}/`}>
  <ArticleShell class="grid gap-6 py-12" data-pagefind-body>
    <header class="grid gap-4 [--section-accent:var(--color-accent)]">
      <VisuallyHidden href="/lab/" revealOnFocus>Back to Lab</VisuallyHidden>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="m-0 max-w-section-copy text-muted">{entry.data.description}</p>
      <ArticleMeta date={entry.data.date} section="lab" />
      <TechIconList technologies={entry.data.technologies} showLabels />
    </header>
    <ArticleProse wide>
      <Content />
    </ArticleProse>
  </ArticleShell>
</BaseLayout>
