---
import { render } from "astro:content";
import ArticleMeta from "../../components/article/ArticleMeta.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import VideoEmbed from "../../components/media/VideoEmbed.astro";
import ContentShell from "../../components/ui/ContentShell.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import Prose from "../../components/ui/Prose.astro";
import { getVideoProjects } from "../../lib/content/collections";

export async function getStaticPaths() {
  const entries = await getVideoProjects();

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/video/${entry.data.slug}/`}>
  <ContentShell class="grid gap-6 py-12" data-pagefind-body>
    <PageIntro
      class="gap-4"
      eyebrow="Video"
      title={entry.data.title}
      titlePagefind
      description={entry.data.description}
      secondary
    >
      <ArticleMeta date={entry.data.date} section="video" />
    </PageIntro>
    <VideoEmbed
      provider={entry.data.provider}
      id={entry.data.videoId}
      title={entry.data.title}
      poster={entry.data.poster}
    />
    <Prose>
      <Content />
    </Prose>
  </ContentShell>
</BaseLayout>
