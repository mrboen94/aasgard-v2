---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import VideoProjectCard from "../../components/media/VideoProjectCard.astro";
import Grid from "../../components/ui/Grid.astro";
import PageIntro from "../../components/ui/PageIntro.astro";
import PageSection from "../../components/ui/PageSection.astro";
import { getVideoProjects } from "../../lib/content/collections";

const entries = await getVideoProjects();
---

<BaseLayout title="Video" description="My video projects and visual media experiments.">
  <PageSection>
    <PageIntro
      eyebrow="Motion"
      title="Video"
      description="My video projects and visual media experiments."
      secondary
    />
    <Grid>
      {entries.map((entry) => <VideoProjectCard entry={entry} />)}
    </Grid>
  </PageSection>
</BaseLayout>
