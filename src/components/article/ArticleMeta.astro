---
import Badge from "../ui/badges/Badge.astro";
import BadgeList from "../ui/badges/BadgeList.astro";
import InlineMeta from "../ui/typography/InlineMeta.astro";

interface Props {
  eyebrow?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  section?: string;
}

const { eyebrow, date, updated, tags = [], section } = Astro.props;
const dateLabel = date.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---

<InlineMeta>
  {
    eyebrow && (
      <Badge
        data-pagefind-meta="eyebrow"
        textCase="uppercase"
        variant="text"
      >
        {eyebrow}
      </Badge>
    )
  }
  {section && <span data-pagefind-meta="section">{section}</span>}
  <time datetime={date.toISOString()} data-pagefind-meta="date">{dateLabel}</time>
  {updated && <span>Updated {updated.toLocaleDateString("en")}</span>}
  {
    tags.length > 0 && (
      <BadgeList ariaLabel="Tags" density="compact">
        {tags.map((tag) => (
          <Badge as="li" data-pagefind-meta="tags" variant="outline">
            {tag}
          </Badge>
        ))}
      </BadgeList>
    )
  }
</InlineMeta>
