---
import Eyebrow from "../ui/Eyebrow.astro";
import TagList from "../ui/TagList.astro";

interface Props {
  eyebrow?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  section?: string;
}

const { eyebrow, date, updated, tags = [], section } = Astro.props;
const dateLabel = date.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-accent text-small text-muted">
  {eyebrow && <Eyebrow as="span" data-pagefind-meta="eyebrow">{eyebrow}</Eyebrow>}
  {section && <span data-pagefind-meta="section">{section}</span>}
  <time datetime={date.toISOString()} data-pagefind-meta="date">{dateLabel}</time>
  {updated && <span>Updated {updated.toLocaleDateString("en")}</span>}
  {tags.length > 0 && <TagList tags={tags} meta="tags" />}
</div>
