---
import {
  articleMetaClass,
  articleMetaListClass,
  articleMetaTagClass,
  eyebrowClass
} from "../../lib/styles/classes";

interface Props {
  eyebrow?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  section?: string;
}

const { eyebrow, date, updated, tags = [], section } = Astro.props;
const dateLabel = date.toLocaleDateString("en", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---

<div class={articleMetaClass}>
  {eyebrow && <span class={eyebrowClass} data-pagefind-meta="eyebrow">{eyebrow}</span>}
  {section && <span data-pagefind-meta="section">{section}</span>}
  <time datetime={date.toISOString()} data-pagefind-meta="date">{dateLabel}</time>
  {updated && <span>Updated {updated.toLocaleDateString("en")}</span>}
  {tags.length > 0 && (
    <ul class={articleMetaListClass} aria-label="Tags">
      {tags.map((tag) => <li class={articleMetaTagClass} data-pagefind-meta="tags">{tag}</li>)}
    </ul>
  )}
</div>
