---
import type { ArticleEntry } from "../../lib/content/collections";
import Aside from "../content/Aside.astro";
import Callout from "../content/Callout.astro";
import CodeNote from "../content/CodeNote.astro";
import DemoFrame from "../content/DemoFrame.astro";
import Figure from "../content/Figure.astro";
import LinkCard from "../content/LinkCard.astro";
import TechIconList from "../icons/TechIconList.astro";
import BaseLayout from "../layout/BaseLayout.astro";
import ArticleShell from "../ui/ArticleShell.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import ArticleHeader from "./ArticleHeader.astro";
import ArticleProse from "./ArticleProse.astro";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  entry: ArticleEntry;
  Content: any;
  headings?: Heading[];
}

const { entry, Content, headings = [] } = Astro.props;
const components = { Aside, Callout, CodeNote, DemoFrame, Figure, LinkCard };
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonical={`/articles/${entry.data.slug}/`}>
  <ArticleShell data-pagefind-body>
    <ArticleHeader entry={entry} />
    <div class="grid items-start gap-8 [grid-template-columns:minmax(12rem,16rem)_minmax(0,1fr)] max-[56rem]:grid-cols-1">
      <aside class="sticky top-6 grid gap-4 border-l-[0.2rem] border-success pl-4 text-muted max-[56rem]:static">
        <Eyebrow>Contents</Eyebrow>
        {tocHeadings.length > 0 ? (
          <ol class="m-0 grid list-none gap-2 p-0">
            {tocHeadings.map((heading) => (
              <li class:list={[heading.depth === 3 && "pl-4"]}>
                <a class="text-muted no-underline" href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="m-0 font-accent">Headings will appear here.</p>
        )}
        <TechIconList technologies={entry.data.technologies} showLabels />
      </aside>
      <ArticleProse wide>
        <Content components={components} />
      </ArticleProse>
    </div>
  </ArticleShell>
</BaseLayout>
