---
import { articleUrl } from "../../lib/content/urls";
import type { ArticleEntry } from "../../lib/content/collections";
import Surface from "../ui/Surface.astro";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
}

const { entry } = Astro.props;
---

<Surface as="article" class="grid gap-4 p-6">
  <a class="grid gap-2 text-inherit no-underline" href={articleUrl(entry.data.slug)}>
    <h3>{entry.data.title}</h3>
    <p class="m-0 text-muted">{entry.data.description}</p>
  </a>
  <ArticleMeta eyebrow={entry.data.eyebrow} date={entry.data.date} tags={entry.data.tags} />
</Surface>
