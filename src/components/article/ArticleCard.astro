---
import { articleUrl } from "../../lib/content/urls";
import type { ArticleEntry } from "../../lib/content/collections";
import {
  listingCardClass,
  listingCardDescriptionClass,
  listingCardLinkClass,
  surfaceClass
} from "../../lib/styles/classes";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
}

const { entry } = Astro.props;
---

<article class:list={[listingCardClass, surfaceClass]}>
  <a class={listingCardLinkClass} href={articleUrl(entry.data.slug)}>
    <h3>{entry.data.title}</h3>
    <p class={listingCardDescriptionClass}>{entry.data.description}</p>
  </a>
  <ArticleMeta eyebrow={entry.data.eyebrow} date={entry.data.date} tags={entry.data.tags} />
</article>
