---
import { articleUrl } from "../../lib/content/urls";
import type { ArticleEntry } from "../../lib/content/collections";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
}

const { entry } = Astro.props;
---

<article class="article-card surface">
  <a class="article-card__link" href={articleUrl(entry.data.slug)}>
    <span class="eyebrow">{entry.data.template}</span>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.description}</p>
  </a>
  <ArticleMeta date={entry.data.date} tags={entry.data.tags} />
</article>

<style>
  .article-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .article-card__link {
    color: inherit;
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  .article-card__link p {
    color: var(--color-muted);
    margin: 0;
  }

  .article-card .eyebrow {
    color: var(--color-accent);
    font-size: 0.78rem;
    text-transform: uppercase;
  }
</style>
