---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<div class:list={["article-prose", wide && "article-prose--wide"]}>
  <slot />
</div>

<style>
  .article-prose {
    max-width: var(--prose);
    min-width: 0;
    overflow-wrap: break-word;
    width: 100%;
  }

  .article-prose--wide {
    max-width: var(--prose-wide);
  }

  .article-prose :global(h2),
  .article-prose :global(h3) {
    margin-block: var(--space-6) var(--space-4);
  }

  .article-prose :global(img),
  .article-prose :global(canvas) {
    border-radius: var(--radius);
  }

  .article-prose :global(img),
  .article-prose :global(video),
  .article-prose :global(iframe) {
    max-width: 100%;
  }

  .article-prose :global(canvas) {
    inline-size: 100%;
  }

  .article-prose :global(pre),
  .article-prose :global(table),
  .article-prose :global(.expressive-code) {
    max-width: 100%;
    border-top-left-radius: 0;
  }

  .article-prose :global(pre),
  .article-prose :global(table) {
    overflow-x: auto;
  }
</style>
