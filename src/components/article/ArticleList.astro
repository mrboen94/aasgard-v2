---
import type { ArticleEntry } from "../../lib/content/collections";
import { gridClass } from "../../lib/styles/classes";
import ArticleCard from "./ArticleCard.astro";

interface Props {
  entries: ArticleEntry[];
}

const { entries } = Astro.props;
---

<div class={gridClass}>
  {entries.map((entry) => <ArticleCard entry={entry} />)}
</div>
