---
import type { ArticleEntry } from "../../lib/content/collections";
import Grid from "../ui/Grid.astro";
import ArticleCard from "./ArticleCard.astro";

interface Props {
  entries: ArticleEntry[];
}

const { entries } = Astro.props;
---

<Grid>
  {entries.map((entry) => <ArticleCard entry={entry} />)}
</Grid>
