---
import type { ArticleEntry } from "../../lib/content/collections";
import { articleUrl } from "../../lib/content/urls";
import EntryCard from "../ui/EntryCard.astro";
import Grid from "../ui/Grid.astro";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entries: ArticleEntry[];
}

const { entries } = Astro.props;
---

<Grid>
  {
    entries.map((entry) => (
      <EntryCard
        description={entry.data.description}
        href={articleUrl(entry.data.slug)}
        title={entry.data.title}
      >
        <ArticleMeta eyebrow={entry.data.eyebrow} date={entry.data.date} tags={entry.data.tags} />
      </EntryCard>
    ))
  }
</Grid>
