---
import type { ArticleEntry } from "../../lib/content/collections";
import {
  articleDescriptionClass,
  articleHeaderClass,
  eyebrowClass
} from "../../lib/styles/classes";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
  eyebrow?: string;
}

const { entry } = Astro.props;
---

<header class={articleHeaderClass}>
  <a class={eyebrowClass} href="/articles">{"< Back"}</a>
  <h1 data-pagefind-meta="title">{entry.data.title}</h1>
  <p class={articleDescriptionClass}>{entry.data.description}</p>
  <ArticleMeta
    date={entry.data.date}
    updated={entry.data.updated}
    tags={entry.data.tags}
    section="articles"
  />
</header>
