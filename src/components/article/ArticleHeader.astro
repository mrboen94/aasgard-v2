---
import type { ArticleEntry } from "../../lib/content/collections";
import Eyebrow from "../ui/Eyebrow.astro";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
  eyebrow?: string;
}

const { entry } = Astro.props;
---

<header class="grid gap-4 pt-12 pb-6">
  <Eyebrow href="/articles">{"< Back"}</Eyebrow>
  <h1 data-pagefind-meta="title">{entry.data.title}</h1>
  <p class="m-0 max-w-section-copy text-lead text-muted">{entry.data.description}</p>
  <ArticleMeta
    date={entry.data.date}
    updated={entry.data.updated}
    tags={entry.data.tags}
    section="articles"
  />
</header>
