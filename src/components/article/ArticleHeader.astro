---
import "./article.css";
import type { ArticleEntry } from "../../lib/content/collections";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  entry: ArticleEntry;
  eyebrow?: string;
}

const { entry, eyebrow = "Article" } = Astro.props;
---

<header class="article-header">
  <p class="eyebrow article-header__eyebrow">{eyebrow}</p>
  <h1 data-pagefind-meta="title">{entry.data.title}</h1>
  <p class="article-header__description">{entry.data.description}</p>
  <ArticleMeta
    date={entry.data.date}
    updated={entry.data.updated}
    tags={entry.data.tags}
    section="articles"
  />
</header>
