---
import type { WorkEntry } from "../../lib/content/collections";
import { gridClass } from "../../lib/styles/classes";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  entries: WorkEntry[];
}

const { entries } = Astro.props;
---

<div class={gridClass}>
  {entries.map((entry) => <ProjectCard entry={entry} />)}
</div>
