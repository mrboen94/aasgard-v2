---
import { Icon } from "astro-icon/components";
import type { WorkEntry } from "../../lib/content/collections";
import { workUrl } from "../../lib/content/urls";
import TechIconList from "../icons/TechIconList.astro";
import Surface from "../ui/Surface.astro";

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const logo = entry.data.logo ?? "custom/placeholder";
const accentStyle = entry.data.accent ? `--project-accent: ${entry.data.accent};` : undefined;
---

<Surface
  as="article"
  class:list={[
    "grid gap-4 p-6",
    "group gap-6 [--project-accent:var(--color-primary)]",
    entry.data.featured && "border-[var(--project-accent)]"
  ]}
  style={accentStyle}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span
      class="grid aspect-square size-12 place-items-center rounded-card bg-code text-[var(--project-accent)] transition-[background-color,color,transform] duration-[var(--duration-theme)] ease-theme group-hover:scale-[1.04] group-focus-within:scale-[1.04] [&_svg]:size-7 [&_svg]:transition-transform [&_svg]:duration-[var(--duration-theme)] [&_svg]:ease-theme"
      aria-hidden="true"
    >
      <Icon name={logo} />
    </span>
    {entry.data.featured && <span class="font-accent text-meta text-muted">Featured</span>}
  </div>
  <div class="grid gap-2">
    <h3><a class="text-inherit no-underline" href={workUrl(entry.data.slug)}>{entry.data.title}</a></h3>
    <p class="m-0 text-muted">{entry.data.description}</p>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3">
    {entry.data.link && <a href={entry.data.link.href}>{entry.data.link.label}</a>}
    <TechIconList technologies={entry.data.technologies} />
  </div>
</Surface>
