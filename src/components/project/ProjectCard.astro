---
import "./project-card.css";
import { Icon } from "astro-icon/components";
import type { WorkEntry } from "../../lib/content/collections";
import { workUrl } from "../../lib/content/urls";
import TechIconList from "../icons/TechIconList.astro";

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const logo = entry.data.logo ?? "custom/placeholder";
const accentStyle = entry.data.accent ? `--project-accent: ${entry.data.accent};` : undefined;
---

<article
  class:list={["project-card", "listing-card", "surface", entry.data.featured && "project-card--featured"]}
  style={accentStyle}
>
  <div class="project-card__top">
    <span class="project-card__logo" aria-hidden="true"><Icon name={logo} /></span>
    {entry.data.featured && <span class="project-card__flag meta">Featured</span>}
  </div>
  <div class="project-card__body listing-card__body">
    <h3><a href={workUrl(entry.data.slug)}>{entry.data.title}</a></h3>
    <p class="listing-card__copy">{entry.data.description}</p>
  </div>
  <div class="project-card__footer">
    {entry.data.link && <a href={entry.data.link.href}>{entry.data.link.label}</a>}
    <TechIconList technologies={entry.data.technologies} />
  </div>
</article>
