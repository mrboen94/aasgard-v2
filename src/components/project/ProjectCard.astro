---
import { Icon } from "astro-icon/components";
import type { WorkEntry } from "../../lib/content/collections";
import { workUrl } from "../../lib/content/urls";
import TechIconList from "../icons/TechIconList.astro";

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const logo = entry.data.logo ?? "custom/placeholder";
---

<article
  class:list={["project-card", "surface", entry.data.featured && "project-card--featured"]}
  style={entry.data.accent ? `--project-accent: ${entry.data.accent}` : undefined}
>
  <div class="project-card__top">
    <span class="project-card__logo" aria-hidden="true"><Icon name={logo} /></span>
    {entry.data.featured && <span class="project-card__flag meta">Featured</span>}
  </div>
  <div class="project-card__body">
    <h3><a href={workUrl(entry.data.slug)}>{entry.data.title}</a></h3>
    <p>{entry.data.description}</p>
  </div>
  <div class="project-card__footer">
    {entry.data.link && <a href={entry.data.link.href}>{entry.data.link.label}</a>}
    <TechIconList technologies={entry.data.technologies} />
  </div>
</article>

<style>
  .project-card {
    --project-accent: var(--color-link);
    display: grid;
    gap: var(--space-5);
    padding: var(--card-padding);
  }

  .project-card--featured {
    border-color: var(--project-accent);
  }

  .project-card__top,
  .project-card__footer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .project-card__logo {
    align-items: center;
    aspect-ratio: 1;
    background: var(--color-code-bg);
    border-radius: var(--radius);
    color: var(--project-accent);
    display: grid;
    inline-size: var(--project-logo-size);
    justify-items: center;
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      color var(--motion-duration-fast) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .project-card__logo :global(svg) {
    block-size: var(--project-logo-glyph-size);
    inline-size: var(--project-logo-glyph-size);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .project-card:has(a:hover) .project-card__logo,
  .project-card:has(a:focus-visible) .project-card__logo {
    transform: scale(1.04);
  }

  .project-card__flag {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .project-card__body {
    display: grid;
    gap: var(--space-2);
  }

  .project-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-card p {
    color: var(--color-muted);
    margin: 0;
  }
</style>
