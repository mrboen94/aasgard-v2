---
interface Props {
  title?: string;
}

const { title = "Code note" } = Astro.props;
---

<aside class="my-4 rounded-card bg-code p-4 font-code transition-[background-color,color] duration-[var(--duration-theme)] ease-theme">
  <p class="mt-0 mb-2 font-accent text-muted">{title}</p>
  <slot />
</aside>
