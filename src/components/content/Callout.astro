---
import Panel from "../ui/Panel.astro";

interface Props {
  title?: string;
  tone?: "note" | "warning" | "success";
}

const { title, tone = "note" } = Astro.props;
const panelTone = {
  note: "primary",
  warning: "accent",
  success: "success"
}[tone];
---

<Panel
  accent="left"
  as="aside"
  class="[&_:last-child]:mb-0"
  margin="md"
  tone={panelTone}
>
  {title && <p class="mt-0 mb-2 font-accent font-bold">{title}</p>}
  <slot />
</Panel>
