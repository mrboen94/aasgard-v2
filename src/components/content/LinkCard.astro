---
import { surfaceClass } from "../../lib/styles/classes";

interface Props {
  href: string;
  title: string;
  description?: string;
}

const { href, title, description } = Astro.props;
---

<a class:list={[surfaceClass, "my-6 block p-4 text-inherit no-underline"]} href={href}>
  <span class="font-bold">{title}</span>
  {description && <p class="mt-1 mb-0 text-muted">{description}</p>}
</a>
