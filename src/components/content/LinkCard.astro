---
import Surface from "../ui/Surface.astro";

interface Props {
  href: string;
  title: string;
  description?: string;
}

const { href, title, description } = Astro.props;
---

<Surface as="a" class="my-6 block p-4 text-inherit no-underline" href={href}>
  <span class="font-bold">{title}</span>
  {description && <p class="mt-1 mb-0 text-muted">{description}</p>}
</Surface>
