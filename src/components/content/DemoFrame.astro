---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="my-8 overflow-hidden rounded-card border border-border p-4 transition-[background-color,border-color] duration-[var(--duration-theme)] ease-theme">
  {title && <h2 class="mb-3 text-base">{title}</h2>}
  <slot />
</section>
