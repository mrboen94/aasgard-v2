---
import "./content.css";

type Tab = {
  id: string;
  label: string;
};

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
const renderedTabs = await Promise.all(
  tabs.map(async (tab, index) => ({
    ...tab,
    active: index === 0,
    html: await Astro.slots.render(tab.id)
  }))
);
const groupId = `code-tabs-${Math.random().toString(36).slice(2)}`;
---

<div class="code-tabs" data-code-tabs>
  {renderedTabs.map((tab) => (
    <section
      aria-label={tab.label}
      class="code-tabs__panel"
      data-code-tab-label={tab.label}
      hidden={!tab.active}
      id={`${groupId}-${tab.id}-panel`}
      role="tabpanel"
      set:html={tab.html}
    />
  ))}
</div>

<script>
  import { mountOnAstroPageLoad } from "../../lib/dom/lifecycle";
  import { mountCodeTabs } from "./codeTabs";

  mountOnAstroPageLoad(mountCodeTabs);
</script>
