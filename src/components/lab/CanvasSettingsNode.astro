---
import type {
  CanvasControl,
  CanvasRangeControl,
  CanvasSettingsLink,
  CanvasSettingsNode
} from "./canvasExperiment";
import Dropdown from "../ui/Dropdown.astro";
import { labelColorClass, labelColorStyle } from "./canvasExperimentDom";

interface Props {
  instanceId: string;
  node: CanvasSettingsNode;
  parentGroupId?: string;
  parentLinks?: CanvasSettingsLink[];
  sceneId: string;
}

const {
  instanceId,
  node,
  parentGroupId,
  parentLinks,
  sceneId
} = Astro.props;

function rangeSizeClass(control: CanvasRangeControl) {
  const size = control.size ?? "default";

  if (size === "full") return "col-span-full w-full";
  if (size === "narrow") return "w-[min(100%,7rem)]";
  if (size === "wide") return "w-[min(100%,16rem)]";

  return "";
}

function rangeValue(control: CanvasRangeControl) {
  return `${control.value}${control.unit ? ` ${control.unit}` : ""}`;
}

function controlClass(control: CanvasControl) {
  if (control.type !== "range") {
    return [
      "canvas-control m-0 min-w-0 gap-1 border-0 p-0 font-accent text-meta text-muted",
      control.type === "checkbox" ? "flex items-center gap-2" : "grid"
    ];
  }

  return [
    "canvas-control m-0 grid min-w-0 gap-1 border-0 p-0 font-accent text-meta text-muted",
    rangeSizeClass(control),
    control.orientation === "vertical" && "w-auto items-center justify-items-center"
  ];
}

function layoutBodyClass(layout?: "cluster" | "column" | "fill" | "grid" | "row") {
  const baseClass = "min-w-0 gap-2";

  switch (layout) {
    case "cluster":
      return [baseClass, "flex flex-wrap items-center gap-2"];
    case "column":
      return [baseClass, "grid grid-cols-1 gap-2"];
    case "fill":
      return [
        baseClass,
        "flex flex-wrap items-end gap-2 [&>.canvas-control]:min-w-0 [&>.canvas-control]:max-w-none [&>.canvas-control]:flex-[1_1_8rem] [&>.canvas-control]:w-auto"
      ];
    case "grid":
      return [
        baseClass,
        "grid items-end gap-2 [grid-template-columns:repeat(auto-fit,minmax(min(100%,8rem),1fr))]"
      ];
    case "row":
      return [baseClass, "flex flex-wrap items-end gap-2"];
    default:
      return [baseClass];
  }
}

function rangeLabelRowClass(control: CanvasRangeControl) {
  return [
    "flex items-center justify-between gap-2",
    control.orientation === "vertical" && "justify-center text-center"
  ];
}

function rangeInputClass(control: CanvasRangeControl) {
  return [
    "w-full accent-success",
    control.orientation === "vertical" && "my-1 h-56 w-6 [direction:rtl] [writing-mode:vertical-lr]"
  ];
}

function outputClass(control: CanvasRangeControl) {
  return [
    "text-foreground tabular-nums",
    control.orientation === "vertical" && "text-center"
  ];
}

function linkLabel(link: CanvasSettingsLink, sourceLabel: string, targetLabels: string) {
  return `Toggle link between ${sourceLabel} and ${targetLabels} (${
    link.enabled === false ? "currently free" : "currently linked"
  })`;
}

const sourceLink = parentLinks?.find((link) => link.source === node.id);
const linkInitiallyEnabled = sourceLink?.enabled !== false;
const linkTargetLabel = sourceLink
  ? sourceLink.targets.map((target) => target.id).join(", ")
  : "";
const linkAriaLabel = sourceLink
  ? linkLabel(sourceLink, node.label, linkTargetLabel)
  : undefined;

type RenderItem =
  | { kind: "single"; node: CanvasSettingsNode }
  | {
      kind: "pair";
      link: CanvasSettingsLink;
      source: CanvasSettingsNode;
      target: CanvasSettingsNode;
    };

let groupItems: RenderItem[] = [];
let unpairedLinks: CanvasSettingsLink[] = [];

if (node.type === "group") {
  const links = node.links ?? [];
  const children = node.children;
  const pairedLinks = new Set<CanvasSettingsLink>();
  let i = 0;

  while (i < children.length) {
    const current = children[i];
    const next = children[i + 1];
    const adjacentLink = next
      ? links.find(
          (link) =>
            !pairedLinks.has(link) &&
            link.source === current.id &&
            link.targets.some((target) => target.id === next.id)
        )
      : undefined;

    if (adjacentLink && next) {
      pairedLinks.add(adjacentLink);
      groupItems.push({
        kind: "pair",
        link: adjacentLink,
        source: current,
        target: next
      });
      i += 2;
    } else {
      groupItems.push({ kind: "single", node: current });
      i += 1;
    }
  }

  unpairedLinks = links.filter((link) => !pairedLinks.has(link));
}

function pairAriaLabel(item: RenderItem & { kind: "pair" }) {
  const targetLabels = item.link.targets
    .map((target) => target.id)
    .join(", ");
  return linkLabel(item.link, item.source.label, targetLabels);
}
---

{
  node.type === "group" && (
    <section
      class:list={[
        "grid min-w-0 gap-2 rounded-none border-0 bg-transparent p-0",
        parentGroupId && node.variant === "plain" && "w-full flex-[1_1_100%]"
      ]}
      data-canvas-group={node.id}
      data-canvas-links={node.links?.length ? JSON.stringify(node.links) : undefined}
      data-canvas-links-enabled={
        node.links?.length
          ? node.links.some((link) => link.enabled !== false)
            ? "true"
            : "false"
          : undefined
      }
    >
      <header class="min-w-0">
        <h3
          class:list={[
            "m-0 flex min-w-0 items-center gap-2 p-0 font-accent text-meta font-bold uppercase tracking-[0.04em] before:h-px before:w-3 before:flex-shrink-0 before:bg-border before:content-[''] after:h-px after:flex-1 after:bg-border after:content-['']",
            labelColorClass(node.labelColor)
          ]}
          style={labelColorStyle(node.labelColor)}
        >
          {node.label}
        </h3>
      </header>
      <div class:list={layoutBodyClass(node.layout)}>
        {groupItems.map((item) =>
          item.kind === "single" ? (
            <Astro.self
              instanceId={instanceId}
              node={item.node}
              parentGroupId={node.id}
              parentLinks={unpairedLinks}
              sceneId={sceneId}
            />
          ) : (
            <div class="col-span-full grid min-w-0 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-end gap-2 [&>.canvas-control]:w-auto [&>.canvas-control]:max-w-full">
              <Astro.self
                instanceId={instanceId}
                node={item.source}
                parentGroupId={node.id}
                sceneId={sceneId}
              />
              <button
                aria-label={pairAriaLabel(item)}
                aria-pressed={item.link.enabled !== false ? "true" : "false"}
                class="mb-[0.35rem] inline-flex size-5 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-muted hover:text-success aria-pressed:bg-[color-mix(in_srgb,var(--color-success)_16%,transparent)] aria-pressed:text-success [&_svg]:block [&_svg]:size-[0.9rem]"
                data-canvas-link-toggle={node.id}
                title={pairAriaLabel(item)}
                type="button"
              >
                <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" viewBox="0 0 16 16">
                  <path d="M6.4 9.6l3.2-3.2" />
                  <path d="M5 7L4 8a2.2 2.2 0 0 0 3.1 3.1L8 10" />
                  <path d="M11 9l1-1A2.2 2.2 0 0 0 8.9 4.9L8 6" />
                </svg>
              </button>
              <Astro.self
                instanceId={instanceId}
                node={item.target}
                parentGroupId={node.id}
                sceneId={sceneId}
              />
            </div>
          )
        )}
      </div>
    </section>
  )
}

{
  node.type === "details" && (
    <details
      class="group grid min-w-0 gap-2 rounded-none border-0 bg-transparent p-0"
      data-canvas-details={node.id}
      open={node.open}
    >
      <summary class="min-w-0 cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden">
        <span
          class:list={[
            "m-0 flex min-w-0 items-center gap-2 p-0 font-accent text-meta font-bold uppercase tracking-[0.04em] before:h-px before:w-3 before:flex-shrink-0 before:bg-border before:content-[''] after:h-px after:flex-1 after:bg-border after:content-['']",
            labelColorClass(node.labelColor)
          ]}
          style={labelColorStyle(node.labelColor)}
        >
          <span
            aria-hidden="true"
            class="inline-block size-[0.45rem] rotate-[-45deg] border-r-[1.5px] border-b-[1.5px] border-current transition-transform duration-[var(--duration-theme)] ease-theme group-open:rotate-45"
          ></span>
          {node.label}
        </span>
      </summary>
      <div class:list={[layoutBodyClass(node.layout), "mt-2"]}>
        {node.children.map((child) => (
          <Astro.self instanceId={instanceId} node={child} sceneId={sceneId} />
        ))}
      </div>
    </details>
  )
}

{
  node.type === "checkbox" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <input
        class="size-4 accent-success"
        checked={node.value}
        data-canvas-control={node.id}
        type="checkbox"
      />
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
    </label>
  )
}

{
  node.type === "radio" && (
    <fieldset
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <legend class:list={labelColorClass(node.labelColor)}>{node.label}</legend>
      <div class="flex flex-wrap gap-3">
        {node.options.map((option) => (
          <label class="flex items-center gap-2">
            <input
              class="size-4 accent-success"
              checked={option.value === node.value}
              data-canvas-control={node.id}
              name={`${instanceId}-${sceneId}-${node.id}`}
              type="radio"
              value={option.value}
            />
            <span>{option.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  )
}

{
  node.type === "select" && (
    <Dropdown
      label={node.label}
      labelClass={labelColorClass(node.labelColor)}
      options={node.options}
      selectAttributes={{ "data-canvas-control": node.id }}
      style={labelColorStyle(node.labelColor)}
      value={node.value}
    />
  )
}

{
  node.type === "preset" && (
    <Dropdown
      label={node.label}
      labelClass={labelColorClass(node.labelColor)}
      options={node.options.map((option) => ({
        label: option.label,
        value: option.value
      }))}
      placeholder={node.placeholder ?? "Choose preset"}
      selectAttributes={{
        "data-canvas-preset": node.id,
        "data-canvas-preset-options": JSON.stringify(node.options)
      }}
      style={labelColorStyle(node.labelColor)}
    />
  )
}

{
  node.type === "number" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
      <input
        class="min-h-8 w-full min-w-0 rounded-small border border-border bg-surface px-2 py-1 font-accent text-meta text-foreground accent-success shadow-none outline-none transition-[background-color,border-color,color,box-shadow] duration-[var(--duration-fast)] ease-theme focus-visible:border-success focus-visible:ring-2 focus-visible:ring-success"
        data-canvas-control={node.id}
        max={node.max}
        min={node.min}
        step={node.step}
        type="number"
        value={node.value}
      />
    </label>
  )
}

{
  node.type === "range" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class:list={rangeLabelRowClass(node)}>
        <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
        {
          node.showValue && node.orientation !== "vertical" && (
            <output
              class:list={outputClass(node)}
              data-canvas-value-for={node.id}
              data-canvas-value-unit={node.unit}
            >
              {rangeValue(node)}
            </output>
          )
        }
      </span>
      <input
        class:list={rangeInputClass(node)}
        data-canvas-control={node.id}
        max={node.max}
        min={node.min}
        step={node.step}
        type="range"
        value={node.value}
      />
      {
        node.showValue && node.orientation === "vertical" && (
          <output
            class:list={outputClass(node)}
            data-canvas-value-for={node.id}
            data-canvas-value-unit={node.unit}
          >
            {rangeValue(node)}
          </output>
        )
      }
      {
        sourceLink && parentGroupId && (
          <button
            aria-label={linkAriaLabel}
            aria-pressed={linkInitiallyEnabled ? "true" : "false"}
            class="mt-1 inline-flex size-5 cursor-pointer items-center justify-center justify-self-center rounded-full border-0 bg-transparent p-0 text-muted hover:text-success aria-pressed:bg-[color-mix(in_srgb,var(--color-success)_16%,transparent)] aria-pressed:text-success [&_svg]:block [&_svg]:size-[0.9rem]"
            data-canvas-link-toggle={parentGroupId}
            title={linkAriaLabel}
            type="button"
          >
            <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" viewBox="0 0 16 16">
              <path d="M6.4 9.6l3.2-3.2" />
              <path d="M5 7L4 8a2.2 2.2 0 0 0 3.1 3.1L8 10" />
              <path d="M11 9l1-1A2.2 2.2 0 0 0 8.9 4.9L8 6" />
            </svg>
          </button>
        )
      }
    </label>
  )
}
