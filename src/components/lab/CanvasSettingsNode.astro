---
import "./canvas-experiment.css";
import type {
  CanvasControl,
  CanvasRangeControl,
  CanvasSettingsLink,
  CanvasSettingsNode
} from "./canvasExperiment";
import { labelColorClass, labelColorStyle } from "./canvasExperimentDom";

interface Props {
  instanceId: string;
  node: CanvasSettingsNode;
  parentGroupId?: string;
  parentLinks?: CanvasSettingsLink[];
  sceneId: string;
}

const {
  instanceId,
  node,
  parentGroupId,
  parentLinks,
  sceneId
} = Astro.props;

function rangeSizeClass(control: CanvasRangeControl) {
  return `canvas-control--${control.size ?? "default"}`;
}

function rangeValue(control: CanvasRangeControl) {
  return `${control.value}${control.unit ? ` ${control.unit}` : ""}`;
}

function controlClass(control: CanvasControl) {
  if (control.type !== "range") {
    return ["canvas-control", `canvas-control--${control.type}`];
  }

  return [
    "canvas-control",
    "canvas-control--range",
    rangeSizeClass(control),
    `canvas-control--${control.orientation ?? "horizontal"}`
  ];
}

function linkLabel(link: CanvasSettingsLink, sourceLabel: string, targetLabels: string) {
  return `Toggle link between ${sourceLabel} and ${targetLabels} (${
    link.enabled === false ? "currently free" : "currently linked"
  })`;
}

const sourceLink = parentLinks?.find((link) => link.source === node.id);
const linkInitiallyEnabled = sourceLink?.enabled !== false;
const linkTargetLabel = sourceLink
  ? sourceLink.targets.map((target) => target.id).join(", ")
  : "";
const linkAriaLabel = sourceLink
  ? linkLabel(sourceLink, node.label, linkTargetLabel)
  : undefined;

type RenderItem =
  | { kind: "single"; node: CanvasSettingsNode }
  | {
      kind: "pair";
      link: CanvasSettingsLink;
      source: CanvasSettingsNode;
      target: CanvasSettingsNode;
    };

let groupItems: RenderItem[] = [];
let unpairedLinks: CanvasSettingsLink[] = [];

if (node.type === "group") {
  const links = node.links ?? [];
  const children = node.children;
  const pairedLinks = new Set<CanvasSettingsLink>();
  let i = 0;

  while (i < children.length) {
    const current = children[i];
    const next = children[i + 1];
    const adjacentLink = next
      ? links.find(
          (link) =>
            !pairedLinks.has(link) &&
            link.source === current.id &&
            link.targets.some((target) => target.id === next.id)
        )
      : undefined;

    if (adjacentLink && next) {
      pairedLinks.add(adjacentLink);
      groupItems.push({
        kind: "pair",
        link: adjacentLink,
        source: current,
        target: next
      });
      i += 2;
    } else {
      groupItems.push({ kind: "single", node: current });
      i += 1;
    }
  }

  unpairedLinks = links.filter((link) => !pairedLinks.has(link));
}

function pairAriaLabel(item: RenderItem & { kind: "pair" }) {
  const targetLabels = item.link.targets
    .map((target) => target.id)
    .join(", ");
  return linkLabel(item.link, item.source.label, targetLabels);
}
---

{
  node.type === "group" && (
    <section
      class:list={[
        "canvas-experiment__group",
        "canvas-controls-layout",
        `canvas-experiment__group--${node.variant}`,
        `canvas-controls-layout--${node.layout}`
      ]}
      data-canvas-group={node.id}
      data-canvas-links={node.links?.length ? JSON.stringify(node.links) : undefined}
      data-canvas-links-enabled={
        node.links?.length
          ? node.links.some((link) => link.enabled !== false)
            ? "true"
            : "false"
          : undefined
      }
    >
      <header class="canvas-experiment__group-header">
        <h3
          class:list={["canvas-experiment__group-label", labelColorClass(node.labelColor)]}
          style={labelColorStyle(node.labelColor)}
        >
          {node.label}
        </h3>
      </header>
      <div class="canvas-experiment__group-body">
        {groupItems.map((item) =>
          item.kind === "single" ? (
            <Astro.self
              instanceId={instanceId}
              node={item.node}
              parentGroupId={node.id}
              parentLinks={unpairedLinks}
              sceneId={sceneId}
            />
          ) : (
            <div class="canvas-experiment__linked-pair">
              <Astro.self
                instanceId={instanceId}
                node={item.source}
                parentGroupId={node.id}
                sceneId={sceneId}
              />
              <button
                aria-label={pairAriaLabel(item)}
                aria-pressed={item.link.enabled !== false ? "true" : "false"}
                class="canvas-experiment__link-toggle canvas-experiment__link-toggle--between"
                data-canvas-link-toggle={node.id}
                title={pairAriaLabel(item)}
                type="button"
              >
                <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" viewBox="0 0 16 16">
                  <path d="M6.4 9.6l3.2-3.2" />
                  <path d="M5 7L4 8a2.2 2.2 0 0 0 3.1 3.1L8 10" />
                  <path d="M11 9l1-1A2.2 2.2 0 0 0 8.9 4.9L8 6" />
                </svg>
              </button>
              <Astro.self
                instanceId={instanceId}
                node={item.target}
                parentGroupId={node.id}
                sceneId={sceneId}
              />
            </div>
          )
        )}
      </div>
    </section>
  )
}

{
  node.type === "details" && (
    <details
      class:list={[
        "canvas-experiment__details",
        node.layout && "canvas-controls-layout",
        node.layout && `canvas-controls-layout--${node.layout}`
      ]}
      data-canvas-details={node.id}
      open={node.open}
    >
      <summary>
        <span
          class:list={["canvas-experiment__group-label", labelColorClass(node.labelColor)]}
          style={labelColorStyle(node.labelColor)}
        >
          <span aria-hidden="true" class="canvas-experiment__chevron"></span>
          {node.label}
        </span>
      </summary>
      <div class="canvas-experiment__details-body">
        {node.children.map((child) => (
          <Astro.self instanceId={instanceId} node={child} sceneId={sceneId} />
        ))}
      </div>
    </details>
  )
}

{
  node.type === "checkbox" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <input
        checked={node.value}
        data-canvas-control={node.id}
        type="checkbox"
      />
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
    </label>
  )
}

{
  node.type === "radio" && (
    <fieldset
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <legend class:list={labelColorClass(node.labelColor)}>{node.label}</legend>
      <div class="canvas-experiment__radio-group">
        {node.options.map((option) => (
          <label>
            <input
              checked={option.value === node.value}
              data-canvas-control={node.id}
              name={`${instanceId}-${sceneId}-${node.id}`}
              type="radio"
              value={option.value}
            />
            <span>{option.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  )
}

{
  node.type === "select" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
      <select data-canvas-control={node.id}>
        {node.options.map((option) => (
          <option selected={option.value === node.value} value={option.value}>
            {option.label}
          </option>
        ))}
      </select>
    </label>
  )
}

{
  node.type === "preset" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
      <select data-canvas-preset={node.id} data-canvas-preset-options={JSON.stringify(node.options)}>
        <option selected value="">
          {node.placeholder ?? "Choose preset"}
        </option>
        {node.options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </label>
  )
}

{
  node.type === "number" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
      <input
        data-canvas-control={node.id}
        max={node.max}
        min={node.min}
        step={node.step}
        type="number"
        value={node.value}
      />
    </label>
  )
}

{
  node.type === "range" && (
    <label
      class:list={controlClass(node)}
      style={labelColorStyle(node.labelColor)}
    >
      <span class="canvas-control__label-row">
        <span class:list={labelColorClass(node.labelColor)}>{node.label}</span>
        {
          node.showValue && node.orientation !== "vertical" && (
            <output data-canvas-value-for={node.id} data-canvas-value-unit={node.unit}>
              {rangeValue(node)}
            </output>
          )
        }
      </span>
      <input
        data-canvas-control={node.id}
        max={node.max}
        min={node.min}
        step={node.step}
        type="range"
        value={node.value}
      />
      {
        node.showValue && node.orientation === "vertical" && (
          <output data-canvas-value-for={node.id} data-canvas-value-unit={node.unit}>
            {rangeValue(node)}
          </output>
        )
      }
      {
        sourceLink && parentGroupId && (
          <button
            aria-label={linkAriaLabel}
            aria-pressed={linkInitiallyEnabled ? "true" : "false"}
            class="canvas-experiment__link-toggle canvas-experiment__link-toggle--trailing"
            data-canvas-link-toggle={parentGroupId}
            title={linkAriaLabel}
            type="button"
          >
            <svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" viewBox="0 0 16 16">
              <path d="M6.4 9.6l3.2-3.2" />
              <path d="M5 7L4 8a2.2 2.2 0 0 0 3.1 3.1L8 10" />
              <path d="M11 9l1-1A2.2 2.2 0 0 0 8.9 4.9L8 6" />
            </svg>
          </button>
        )
      }
    </label>
  )
}
