---
import type { ExperimentEntry } from "../../lib/content/collections";
import { labUrl } from "../../lib/content/urls";
import {
  listingCardClass,
  listingCardDescriptionClass,
  listingCardEyebrowClass,
  listingCardLinkClass,
  surfaceClass
} from "../../lib/styles/classes";
import TechIconList from "../icons/TechIconList.astro";

interface Props {
  entry: ExperimentEntry;
}

const { entry } = Astro.props;
---

<article class:list={[listingCardClass, surfaceClass, "[--listing-card-accent:var(--color-success)]"]}>
  <a class={listingCardLinkClass} href={labUrl(entry.data.slug)}>
    <span class={listingCardEyebrowClass}>{entry.data.status}</span>
    <h3>{entry.data.title}</h3>
    <p class={listingCardDescriptionClass}>{entry.data.description}</p>
  </a>
  <TechIconList technologies={entry.data.technologies} />
</article>
