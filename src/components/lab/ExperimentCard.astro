---
import type { ExperimentEntry } from "../../lib/content/collections";
import { labUrl } from "../../lib/content/urls";
import TechIconList from "../icons/TechIconList.astro";
import Surface from "../ui/Surface.astro";

interface Props {
  entry: ExperimentEntry;
}

const { entry } = Astro.props;
---

<Surface as="article" class="grid gap-4 p-6 [--listing-card-accent:var(--color-success)]">
  <a class="grid gap-2 text-inherit no-underline" href={labUrl(entry.data.slug)}>
    <span class="font-accent text-meta text-[var(--listing-card-accent,var(--color-accent))] uppercase">
      {entry.data.status}
    </span>
    <h3>{entry.data.title}</h3>
    <p class="m-0 text-muted">{entry.data.description}</p>
  </a>
  <TechIconList technologies={entry.data.technologies} />
</Surface>
