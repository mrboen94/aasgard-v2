---
import CanvasSettingsNode from "./CanvasSettingsNode.astro";
import type {
  CanvasExperimentScene,
  CanvasSettings,
  CanvasSettingsNode as CanvasSettingsTreeNode,
  CanvasSettingsTree
} from "./canvasExperiment";

interface Props {
  ariaLabel?: string;
  canvasMargin?: number;
  fallback?: boolean;
  imageSrc?: string;
  scenes?: CanvasExperimentScene[];
  script?: string;
  settings?: CanvasSettingsTree;
}

const {
  ariaLabel = "Interactive canvas experiment",
  canvasMargin = 0,
  fallback = true,
  imageSrc,
  scenes,
  script,
  settings = []
} = Astro.props;

const sceneList =
  scenes && scenes.length > 0
    ? scenes.map((scene, index) => ({
        ...scene,
        id: scene.id || `scene-${index + 1}`,
        label: scene.label || `Scene ${index + 1}`,
        settings: scene.settings ?? []
      }))
    : script
      ? [
          {
            ariaLabel,
            id: "default",
            imageSrc,
            label: "Scene",
            script,
            settings
          }
        ]
      : [];

if (sceneList.length === 0) {
  throw new Error("CanvasExperiment requires either a script or scenes.");
}

function collectInitialSettings(nodes: CanvasSettingsTreeNode[]) {
  const initialSettings: CanvasSettings = {};

  for (const node of nodes) {
    if (node.type === "group" || node.type === "details") {
      Object.assign(initialSettings, collectInitialSettings(node.children));
      continue;
    }

    if (node.type !== "preset") {
      initialSettings[node.id] = node.value;
    }
  }

  return initialSettings;
}

const initialSettingsByScene = Object.fromEntries(
  sceneList.map((scene) => [
    scene.id,
    collectInitialSettings(scene.settings ?? [])
  ])
) satisfies Record<string, CanvasSettings>;
const runtimeScenes = sceneList.map(({ ariaLabel, id, imageSrc, label, script }) => ({
  ariaLabel,
  id,
  imageSrc,
  label,
  script
}));
const activeScene = sceneList[0];
const instanceId = `canvas-experiment-${Math.random().toString(36).slice(2)}`;
const canvasMarginStyle = `--canvas-experiment-margin: ${canvasMargin}px;`;
const shouldRenderFallback = fallback && sceneList.some((scene) => Boolean(scene.imageSrc));
---

<figure
  class:list={[
    "relative my-8 w-full max-w-full overflow-hidden rounded-card border border-border bg-code transition-[background-color,border-color] duration-[var(--duration-theme)] ease-theme [&.canvas-experiment--with-image>canvas]:aspect-auto [&.canvas-experiment--with-image:not([data-ready=true])>canvas]:opacity-0 [&>canvas]:block [&>canvas]:aspect-video [&>canvas]:w-full [&>canvas]:max-w-full [&>canvas]:bg-transparent [&>canvas]:transition-opacity [&>canvas]:duration-[var(--duration-theme)] [&>canvas]:ease-theme [&[data-ready=true]_.canvas-experiment__fallback]:pointer-events-none [&[data-ready=true]_.canvas-experiment__fallback]:absolute [&[data-ready=true]_.canvas-experiment__fallback]:opacity-0",
    activeScene.imageSrc && "canvas-experiment--with-image"
  ]}
  data-active-scene-id={activeScene.id}
  data-canvas-experiment
  data-default-aria-label={ariaLabel}
  data-image-src={activeScene.imageSrc}
  data-scenes={JSON.stringify(runtimeScenes)}
  data-settings={JSON.stringify(initialSettingsByScene)}
  style={canvasMarginStyle}
>
  {
    sceneList.length > 1 && (
      <div
        class="flex flex-wrap gap-3 border-b border-border bg-[color-mix(in_srgb,var(--color-surface)_68%,transparent)] px-4 pt-3"
        role="tablist"
        aria-label="Canvas scenes"
      >
        {sceneList.map((scene) => (
          <button
            aria-controls={`${instanceId}-${scene.id}-controls`}
            aria-selected={scene.id === activeScene.id ? "true" : "false"}
            class="cursor-pointer border-0 border-b-[0.15rem] border-b-transparent bg-transparent px-0 pb-2 font-accent text-meta text-muted aria-selected:border-b-success aria-selected:text-foreground"
            data-canvas-scene-tab={scene.id}
            role="tab"
            tabindex={scene.id === activeScene.id ? 0 : -1}
            type="button"
          >
            {scene.label}
          </button>
        ))}
      </div>
    )
  }
  <canvas aria-label={activeScene.ariaLabel ?? ariaLabel}></canvas>
  {
    shouldRenderFallback && (
      <img
        alt=""
        class="canvas-experiment__fallback block h-auto w-full max-w-full rounded-card transition-opacity duration-[var(--duration-theme)] ease-theme"
        hidden={!activeScene.imageSrc}
        loading="lazy"
        src={activeScene.imageSrc}
      />
    )
  }
  <div
    aria-live="polite"
    class="flex flex-wrap gap-2 border-t border-border px-4 py-3"
    data-canvas-debug
    hidden
  ></div>
  {
    sceneList.map(
      (scene) =>
        scene.settings?.length ? (
          <figcaption
            aria-label={`${scene.label} canvas controls`}
            class="grid grid-cols-1 items-start gap-2 border-t border-border p-3"
            data-canvas-controls-panel
            data-canvas-scene-id={scene.id}
            hidden={scene.id !== activeScene.id}
            id={`${instanceId}-${scene.id}-controls`}
          >
            {scene.settings.map((node) => (
              <CanvasSettingsNode instanceId={instanceId} node={node} sceneId={scene.id} />
            ))}
          </figcaption>
        ) : null
    )
  }
</figure>

<script>
  import { mountCanvasExperiments } from "./canvasExperimentRuntime";

  mountCanvasExperiments();
  document.addEventListener("astro:page-load", mountCanvasExperiments);
</script>
