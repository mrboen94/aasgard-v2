---
import "./media.css";

interface Props {
  provider: "youtube" | "vimeo" | "mux" | "local";
  id: string;
  title: string;
  poster?: string;
}

const { provider, id, title, poster } = Astro.props;
const hrefByProvider = {
  youtube: `https://www.youtube.com/watch?v=${id}`,
  vimeo: `https://vimeo.com/${id}`,
  mux: `https://stream.mux.com/${id}`,
  local: id
};
---

<figure class="video-embed">
  <a href={hrefByProvider[provider]}>
    <span class="video-embed__poster">
      {poster && <img alt="" class="video-embed__poster-image" loading="lazy" src={poster} />}
    </span>
    <span class="video-embed__play meta">Open {provider} video</span>
  </a>
  <figcaption>{title}</figcaption>
</figure>
