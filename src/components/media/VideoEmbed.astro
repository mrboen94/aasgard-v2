---
import {
  captionClass,
  mediaPlaceholderClass
} from "../../lib/styles/classes";

interface Props {
  provider: "youtube" | "vimeo" | "mux" | "local";
  id: string;
  title: string;
  poster?: string;
}

const { provider, id, title, poster } = Astro.props;
const hrefByProvider = {
  youtube: `https://www.youtube.com/watch?v=${id}`,
  vimeo: `https://vimeo.com/${id}`,
  mux: `https://stream.mux.com/${id}`,
  local: id
};
---

<figure class="my-8">
  <a class="group relative grid text-inherit no-underline" href={hrefByProvider[provider]}>
    <span
      class:list={[
        mediaPlaceholderClass,
        "block aspect-video overflow-hidden rounded-card border border-border bg-center bg-cover transition-[background-color,border-color,transform] duration-[var(--duration-theme)] ease-theme group-hover:scale-[1.01] group-focus-visible:scale-[1.01]"
      ]}
    >
      {poster && <img alt="" class="size-full object-cover" loading="lazy" src={poster} />}
    </span>
    <span
      class="absolute top-1/2 left-1/2 rounded-full border border-border bg-surface px-3 py-2 font-accent transition-[background-color,border-color,color,transform] duration-[var(--duration-theme)] ease-theme -translate-x-1/2 -translate-y-1/2 group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
    >
      Open {provider} video
    </span>
  </a>
  <figcaption class={captionClass}>{title}</figcaption>
</figure>
