---
import "./media.css";
import type { PhotoProjectEntry } from "../../lib/content/collections";
import { photoProjectUrl } from "../../lib/content/urls";

interface Props {
  entry: PhotoProjectEntry;
}

const { entry } = Astro.props;
---

<article class="photo-card surface">
  <a href={photoProjectUrl(entry.data.slug)}>
    <span class="photo-card__media media-placeholder" aria-hidden="true"></span>
    <span class="photo-card__text">
      <h3>{entry.data.title}</h3>
      <p class="listing-card__copy">{entry.data.description}</p>
    </span>
  </a>
</article>
