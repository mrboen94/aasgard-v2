---
import type { PhotoProjectEntry } from "../../lib/content/collections";
import { photoProjectUrl } from "../../lib/content/urls";

interface Props {
  entry: PhotoProjectEntry;
}

const { entry } = Astro.props;
---

<article class="photo-card surface">
  <a href={photoProjectUrl(entry.data.slug)}>
    <span class="photo-card__media" aria-hidden="true"></span>
    <span class="photo-card__text">
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </span>
  </a>
</article>

<style>
  .photo-card {
    overflow: hidden;
  }

  .photo-card a {
    color: inherit;
    display: grid;
    text-decoration: none;
  }

  .photo-card__media {
    aspect-ratio: 4 / 3;
    background: var(--media-placeholder-background);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .photo-card__text {
    display: grid;
    gap: var(--card-text-gap);
    padding: var(--space-4);
  }

  .photo-card p {
    color: var(--color-muted);
    margin: 0;
  }

  .photo-card:has(a:hover) .photo-card__media,
  .photo-card:has(a:focus-visible) .photo-card__media {
    transform: scale(1.015);
  }
</style>
