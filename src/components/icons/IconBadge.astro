---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;
---

<span class="icon-badge" title={label}>
  <Icon name={name} aria-hidden="true" />
  <span class="visually-hidden">{label}</span>
</span>

<style>
  .icon-badge {
    align-items: center;
    aspect-ratio: 1;
    border: var(--border);
    border-radius: var(--radius);
    display: inline-grid;
    inline-size: 2.5rem;
    justify-items: center;
  }

  .icon-badge :global(svg) {
    block-size: 1.4rem;
    inline-size: 1.4rem;
  }
</style>
