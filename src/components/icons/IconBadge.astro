---
import { Icon } from "astro-icon/components";
import { visuallyHiddenClass } from "../../lib/styles/classes";

interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;
---

<span
  class="inline-grid aspect-square size-10 items-center justify-items-center rounded-card border border-border transition-[border-color,color,transform] duration-[var(--duration-fast)] ease-theme [&_svg]:size-[1.4rem] [&_svg]:transition-transform [&_svg]:duration-[var(--duration-fast)] [&_svg]:ease-theme"
  title={label}
>
  <Icon name={name} aria-hidden="true" />
  <span class={visuallyHiddenClass}>{label}</span>
</span>
