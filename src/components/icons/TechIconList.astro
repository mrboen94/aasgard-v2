---
import "./icons.css";
import TechIcon from "./TechIcon.astro";

interface Props {
  technologies?: string[];
  showLabels?: boolean;
}

const { technologies = [], showLabels = false } = Astro.props;
---

{technologies.length > 0 && (
  <ul class="tech-icon-list" aria-label="Technologies">
    {technologies.map((technology) => (
      <li><TechIcon id={technology} showLabel={showLabels} /></li>
    ))}
  </ul>
)}
