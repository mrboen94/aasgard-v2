---
import { Icon } from "astro-icon/components";
import { resolveTechnology } from "../../lib/icons/resolveTechnology";

interface Props {
  id: string;
  showLabel?: boolean;
}

const { id, showLabel = false } = Astro.props;
const technology = resolveTechnology(id);
const shouldShowLabel = showLabel || (technology.unknown && import.meta.env.DEV);
---

<span class:list={["tech-icon", technology.unknown && "tech-icon--unknown"]} title={technology.label}>
  <Icon name={technology.icon} aria-hidden="true" />
  {shouldShowLabel && <span class="tech-label">{technology.unknown ? `Unknown: ${id}` : technology.label}</span>}
</span>

<style>
  .tech-icon {
    align-items: center;
    display: inline-flex;
    gap: var(--space-2);
    min-height: 1.75rem;
  }

  .tech-icon :global(svg) {
    block-size: 1.15rem;
    flex: 0 0 auto;
    inline-size: 1.15rem;
  }

  .tech-icon--unknown {
    color: var(--color-muted);
  }

  .tech-label {
    font-size: 0.78rem;
  }
</style>
