---
import { Icon } from "astro-icon/components";
import { resolveTechnology } from "../../lib/icons/resolveTechnology";

interface Props {
  id: string;
  showLabel?: boolean;
}

const { id, showLabel = false } = Astro.props;
const technology = resolveTechnology(id);
const shouldShowLabel = showLabel || (technology.unknown && import.meta.env.DEV);
---

<span
  class:list={[
    "inline-flex min-h-7 items-center gap-2 transition-[color,opacity] duration-[var(--duration-fast)] ease-theme [&_svg]:size-[1.15rem] [&_svg]:flex-none [&_svg]:transition-transform [&_svg]:duration-[var(--duration-fast)] [&_svg]:ease-theme",
    technology.unknown && "text-muted"
  ]}
  title={technology.label}
>
  <Icon name={technology.icon} aria-hidden="true" />
  {shouldShowLabel && (
    <span class="font-accent text-meta">{technology.unknown ? `Unknown: ${id}` : technology.label}</span>
  )}
</span>
