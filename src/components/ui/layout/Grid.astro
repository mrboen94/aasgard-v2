---
interface Props {
  as?: string;
  class?: string;
  [key: string]: any;
}

const { as = "div", class: className, ...attrs } = Astro.props as Props;
const Tag = as;
---

<Tag
  class:list={[
    "grid gap-6 [grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))]",
    className
  ]}
  {...attrs}
>
  <slot />
</Tag>
