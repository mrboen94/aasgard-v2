---
interface Props {
  as?: string;
  class?: string;
  layout?: "none" | "wrap";
  size?: "meta" | "small";
  tone?: "foreground" | "muted";
  [key: string]: any;
}

const {
  as = "div",
  class: className,
  layout = "wrap",
  size = "small",
  tone = "muted",
  ...attrs
} = Astro.props as Props;
const Tag = as;

const layoutClass = {
  none: "",
  wrap: "flex flex-wrap items-center gap-x-3 gap-y-2"
}[layout];

const sizeClass = {
  meta: "text-meta",
  small: "text-small"
}[size];

const toneClass = {
  foreground: "text-foreground",
  muted: "text-muted"
}[tone];
---

<Tag
  class:list={[
    "font-accent",
    layoutClass,
    sizeClass,
    toneClass,
    className
  ]}
  {...attrs}
>
  <slot />
</Tag>
