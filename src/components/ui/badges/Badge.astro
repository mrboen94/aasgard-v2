---
interface Props {
  as?: string;
  class?: string;
  color?: string;
  href?: string;
  size?: "sm" | "md";
  textCase?: "normal" | "uppercase";
  tone?: "accent" | "danger" | "foreground" | "muted" | "primary" | "success";
  variant?: "icon" | "outline" | "text";
  [key: string]: any;
}

const {
  as,
  class: className,
  color,
  href,
  size = "sm",
  textCase = "normal",
  tone,
  variant = "text",
  ...attrs
} = Astro.props as Props;
const Tag = as ?? (href ? "a" : "span");

const toneColor = tone ? `var(--color-${tone})` : undefined;
const badgeColor = color ?? toneColor;
const colorStyle = badgeColor ? `--badge-color: ${badgeColor};` : undefined;
const styleAttrs = colorStyle ? { style: colorStyle } : {};
const tagAttrs = href ? { ...attrs, href } : attrs;

const variantClass = {
  icon:
    "inline-grid aspect-square items-center justify-items-center rounded-card border border-border transition-[border-color,color,transform] duration-[var(--duration-fast)] ease-theme [&_svg]:transition-transform [&_svg]:duration-[var(--duration-fast)] [&_svg]:ease-theme",
  outline: "rounded-full border border-border",
  text:
    "m-0 font-accent text-[var(--badge-color,var(--section-accent,var(--color-accent)))] no-underline transition-colors duration-[var(--duration-theme)] ease-theme"
}[variant];

const sizeClass = {
  sm:
    variant === "icon"
      ? "size-10 [&_svg]:size-[1.4rem]"
      : variant === "outline"
        ? "px-2 text-meta"
        : "text-meta",
  md:
    variant === "icon"
      ? "size-12 [&_svg]:size-7"
      : variant === "outline"
        ? "px-3 py-1 text-small"
        : "text-small"
}[size];
---

<Tag
  class:list={[
    variantClass,
    variant !== "icon" && sizeClass,
    variant === "icon" && sizeClass,
    textCase === "uppercase" && "uppercase",
    className
  ]}
  {...styleAttrs}
  {...tagAttrs}
>
  <slot />
</Tag>
