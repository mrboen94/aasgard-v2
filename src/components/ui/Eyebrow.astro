---
interface Props {
  as?: string;
  class?: string;
  href?: string;
  [key: string]: any;
}

const { as, class: className, href, ...attrs } = Astro.props as Props;
const Tag = as ?? (href ? "a" : "p");
const tagAttrs = href ? { ...attrs, href } : attrs;
---

<Tag
  class:list={[
    "m-0 font-accent text-[var(--section-accent,var(--color-accent))] uppercase no-underline transition-colors duration-[var(--duration-theme)] ease-theme",
    className
  ]}
  {...tagAttrs}
>
  <slot />
</Tag>
