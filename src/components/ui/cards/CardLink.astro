---
import Card from "./Card.astro";

interface Props {
  description?: string;
  href: string;
  title: string;
}

const { href, title, description } = Astro.props;
---

<Card as="a" class="my-6 block text-inherit no-underline" href={href} padding="sm">
  <span class="font-bold">{title}</span>
  {description && <p class="mt-1 mb-0 text-muted">{description}</p>}
</Card>
