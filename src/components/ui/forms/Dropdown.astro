---
import Field from "./Field.astro";

type DropdownOption = {
  label: string;
  muted?: boolean;
  value: string;
};

interface Props {
  class?: string;
  label: string;
  labelClass?: string | string[];
  options: DropdownOption[];
  placeholder?: string;
  selectAttributes?: Record<string, string | undefined>;
  value?: string;
  [key: string]: any;
}

const {
  class: className,
  label,
  labelClass,
  options,
  placeholder,
  selectAttributes = {},
  value = "",
  ...attrs
} = Astro.props as Props;
---

<Field class={className} {...attrs}>
  <span class:list={labelClass}>{label}</span>
  <select
    class="min-h-8 w-full min-w-0 rounded-small border border-border bg-surface px-2 py-1 font-accent text-meta text-foreground accent-success shadow-none outline-none transition-[background-color,border-color,color,box-shadow] duration-[var(--duration-fast)] ease-theme focus-visible:border-success focus-visible:ring-2 focus-visible:ring-success"
    {...selectAttributes}
  >
    {
      placeholder && (
        <option class="bg-surface text-muted" selected={!value} value="">
          {placeholder}
        </option>
      )
    }
    {
      options.map((option) => (
        <option
          class:list={["bg-surface", option.muted ? "text-muted" : "text-foreground"]}
          selected={option.value === value}
          value={option.value}
        >
          {option.label}
        </option>
      ))
    }
  </select>
</Field>
