---
import Tag from "./Tag.astro";

interface Props {
  ariaLabel?: string;
  class?: string;
  meta?: string;
  tags: string[];
}

const {
  ariaLabel = "Tags",
  class: className,
  meta,
  tags
} = Astro.props as Props;
---

<ul class:list={["m-0 flex list-none flex-wrap gap-2 p-0", className]} aria-label={ariaLabel}>
  {tags.map((tag) => <Tag data-pagefind-meta={meta}>{tag}</Tag>)}
</ul>
