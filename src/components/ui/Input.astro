---
interface Props {
  class?: string;
  orientation?: "horizontal" | "vertical";
  variant?: "choice" | "field" | "range";
  [key: string]: any;
}

const {
  class: className,
  orientation,
  variant = "field",
  ...attrs
} = Astro.props as Props;

const variantClass = {
  choice: "size-4 accent-success",
  field:
    "min-h-8 w-full min-w-0 rounded-small border border-border bg-surface px-2 py-1 font-accent text-meta text-foreground accent-success shadow-none outline-none transition-[background-color,border-color,color,box-shadow] duration-[var(--duration-fast)] ease-theme focus-visible:border-success focus-visible:ring-2 focus-visible:ring-success",
  range: "w-full accent-success"
}[variant];
---

<input
  class:list={[
    variantClass,
    variant === "range" &&
      orientation === "vertical" &&
      "my-1 h-56 w-6 [direction:rtl] [writing-mode:vertical-lr]",
    className
  ]}
  {...attrs}
/>
