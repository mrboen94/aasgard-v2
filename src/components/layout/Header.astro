---
import { NAV_LINKS, isLinkActive } from "../../lib/navigation/links";

const pathname = Astro.url.pathname;
---

<header
  class="site-header"
  transition:name="site-header"
  transition:persist="site-header"
>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Aasgard</a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul class="site-header__nav-list">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} aria-current={isLinkActive(link.href, pathname) ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
      <span class="site-header__nav-indicator" aria-hidden="true"></span>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    gap: var(--space-5);
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    color: var(--color-text);
    font-family: var(--font-accent);
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      opacity var(--motion-duration-fast) var(--motion-ease);
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    opacity: 0.72;
  }

  .site-header__nav {
    position: relative;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: var(--text-nav);
    text-decoration: none;
    transition: color var(--motion-duration-page) var(--motion-ease-emphasized);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current="page"] {
    color: var(--color-accent-2);
  }

  .site-header__nav-indicator {
    background: var(--color-accent-2);
    height: 0.12em;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    transform: translate(var(--nav-indicator-x, 0), var(--nav-indicator-y, 0));
    transition: none;
    width: var(--nav-indicator-w, 0);
  }

  .site-header__nav[data-ready="true"] .site-header__nav-indicator {
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      opacity var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration-page) var(--motion-ease-emphasized),
      width var(--motion-duration-page) var(--motion-ease-emphasized);
  }

  .site-header__nav[data-active="true"] .site-header__nav-indicator {
    opacity: 1;
  }
</style>
