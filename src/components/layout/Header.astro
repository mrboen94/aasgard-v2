---
import { NAV_LINKS, isCurrentRouteHref, isLinkActive } from "../../lib/navigation/links";

const pathname = Astro.url.pathname;
const isHomePage = isCurrentRouteHref("/", pathname);
---

<header class="site-header" transition:animate="none">
  <div class="container site-header__inner">
    {
      isHomePage ? (
        <span class="site-header__brand" aria-current="page">Aasgard</span>
      ) : (
        <a class="site-header__brand" href="/">Aasgard</a>
      )
    }
    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul class="site-header__nav-list">
        {NAV_LINKS.map((link) => {
          const isCurrent = isCurrentRouteHref(link.href, pathname);
          return (
            <li>
              {
                isCurrent ? (
                  <span aria-current="page">{link.label}</span>
                ) : (
                  <a href={link.href} aria-current={isLinkActive(link.href, pathname) ? "page" : undefined}>
                    {link.label}
                  </a>
                )
              }
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    gap: var(--space-5);
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    color: var(--color-text);
    font-family: var(--font-accent);
    font-weight: 700;
    text-decoration: none;
    transition: opacity var(--motion-duration-fast) var(--motion-ease);
  }

  a.site-header__brand:hover,
  a.site-header__brand:focus-visible {
    opacity: 0.72;
  }

  .site-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav :is(a, span) {
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: var(--text-nav);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus {
    color: var(--color-text);
  }

  .site-header__nav [aria-current="page"] {
    color: var(--color-accent-2);
  }
</style>
