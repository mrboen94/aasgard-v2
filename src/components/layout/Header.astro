---
import { NAV_LINKS } from "../../lib/navigation/links";
import Container from "../ui/Container.astro";

const pathname = Astro.url.pathname;
---

<header class="border-b border-border">
  <Container class="flex items-center justify-between gap-6 py-4">
    <a
      class="inline-flex items-center gap-2 font-accent font-bold text-foreground no-underline hover:opacity-70 focus-visible:opacity-70"
      href="/"
    >
      <span
        class="block size-5 flex-none bg-current transition-colors duration-[var(--duration-fast)] ease-theme [-webkit-mask:url(/logo.svg)_center/contain_no-repeat] [mask:url(/logo.svg)_center/contain_no-repeat]"
        aria-hidden="true"
      ></span>
      <span>ForcePushMain</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul class="m-0 flex list-none flex-wrap justify-end gap-x-4 gap-y-3 p-0">
        {
          NAV_LINKS.map((link) => {
            return (
              <li>
                <a
                  class="font-accent text-nav text-muted no-underline hover:text-foreground focus:text-foreground aria-[current=page]:text-success"
                  href={link.href}
                  aria-current={pathname === link.href ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>
