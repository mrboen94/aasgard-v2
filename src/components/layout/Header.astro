---
const links = [
  { href: "/articles/", label: "Articles" },
  { href: "/lab/", label: "Lab" },
  { href: "/work/", label: "Work" },
  { href: "/photography/", label: "Photography" },
  { href: "/video/", label: "Video" },
  { href: "/search/", label: "Search" }
];

const pathname = Astro.url.pathname;
---

<header
  class="site-header"
  transition:name="site-header"
  transition:persist="site-header"
  transition:animate="none"
>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Aasgard</a>
    <nav aria-label="Primary navigation">
      <ul class="site-header__nav">
        {links.map((link) => {
          const isActive = pathname === link.href || pathname.startsWith(link.href);

          return (
            <li><a href={link.href} aria-current={isActive ? "page" : undefined}>{link.label}</a></li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
    transition:
      background-color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    gap: var(--space-5);
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    color: var(--color-text);
    font-family: var(--font-accent);
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      opacity var(--motion-duration-fast) var(--motion-ease);
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    opacity: 0.72;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    justify-content: flex-end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-muted);
    font-family: var(--font-accent);
    font-size: var(--text-nav);
    text-decoration: none;
    transition:
      color var(--motion-duration-fast) var(--motion-ease),
      text-decoration-color var(--motion-duration-fast) var(--motion-ease);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus {
    color: var(--color-text);
  }

  .site-header__nav a[aria-current="page"] {
    color: var(--color-accent-2);
  }

  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-2);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.3em;
  }
</style>
