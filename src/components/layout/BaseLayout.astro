---
import { ClientRouter } from "astro:transitions";
import "../../styles/global.css";
import Footer from "./Footer.astro";
import Head from "./Head.astro";
import Header from "./Header.astro";
import SkipLink from "./SkipLink.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} canonical={canonical} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content" transition:name="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import { isLinkActive, routeSectionIndex } from "../../lib/navigation/links";

      function updateActiveNavigation(pathname = window.location.pathname) {
        document.querySelectorAll<HTMLAnchorElement>(".site-header__nav a").forEach((link) => {
          const href = link.getAttribute("href");
          if (href && isLinkActive(href, pathname)) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        syncNavIndicator();
      }

      function syncNavIndicator() {
        const nav = document.querySelector<HTMLElement>(".site-header__nav");
        if (!nav) return;

        const active = nav.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
        if (!active) {
          nav.dataset.active = "false";
          return;
        }

        const linkRect = active.getBoundingClientRect();
        const navRect = nav.getBoundingClientRect();
        nav.style.setProperty("--nav-indicator-x", `${linkRect.left - navRect.left}px`);
        nav.style.setProperty("--nav-indicator-y", `${linkRect.bottom - navRect.top}px`);
        nav.style.setProperty("--nav-indicator-w", `${linkRect.width}px`);
        nav.dataset.active = "true";

        if (nav.dataset.ready !== "true") {
          requestAnimationFrame(() => {
            nav.dataset.ready = "true";
          });
        }
      }

      function routeDepth(pathname: string) {
        return pathname.split("/").filter(Boolean).length;
      }

      function isHeaderNavigation(sourceElement: Element | null | undefined) {
        return sourceElement instanceof Element && Boolean(sourceElement.closest(".site-header"));
      }

      function resolveTransitionDirection(fromPath: string, toPath: string, sourceElement?: Element | null) {
        const fromIndex = routeSectionIndex(fromPath);
        const toIndex = routeSectionIndex(toPath);
        const fromDepth = routeDepth(fromPath);
        const toDepth = routeDepth(toPath);
        const headerNavigation = isHeaderNavigation(sourceElement);

        if (fromDepth > toDepth) {
          return "ascend";
        }

        if (!headerNavigation && toDepth > fromDepth) {
          return "descend";
        }

        if (toIndex !== fromIndex) {
          return toIndex > fromIndex ? "forward" : "back";
        }

        if (toPath.length > fromPath.length && toPath.startsWith(fromPath)) {
          return "descend";
        }

        if (fromPath.length > toPath.length && fromPath.startsWith(toPath)) {
          return "ascend";
        }

        return "forward";
      }

      function syncNavigationForTransition(event: Event) {
        const transition = event as Event & {
          direction: string;
          from: URL;
          navigationType: string;
          sourceElement?: Element | null;
          to: URL;
          preventDefault?: () => void;
        };

        if (transition.from.href === transition.to.href) {
          transition.preventDefault?.();
          return;
        }

        updateActiveNavigation(transition.to.pathname);
        transition.direction = resolveTransitionDirection(
          transition.from.pathname,
          transition.to.pathname,
          transition.sourceElement
        );
      }

      updateActiveNavigation();

      if (document.documentElement.dataset.navigationMounted !== "true") {
        document.documentElement.dataset.navigationMounted = "true";
        document.addEventListener("astro:page-load", () => updateActiveNavigation());
        document.addEventListener("astro:before-preparation", syncNavigationForTransition);

        let resizeFrame = 0;
        window.addEventListener("resize", () => {
          const nav = document.querySelector<HTMLElement>(".site-header__nav");
          if (!nav) return;
          nav.dataset.ready = "false";
          cancelAnimationFrame(resizeFrame);
          resizeFrame = requestAnimationFrame(() => {
            syncNavIndicator();
          });
        });
      }
    </script>
  </body>
</html>
