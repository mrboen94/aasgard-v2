---
import { ClientRouter } from "astro:transitions";
import "../../styles/global.css";
import Footer from "./Footer.astro";
import Head from "./Head.astro";
import Header from "./Header.astro";
import SkipLink from "./SkipLink.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} canonical={canonical} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content" transition:name="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import { mountRouteTransitionSync } from "../../lib/navigation/routeTransitions";

      mountRouteTransitionSync();
    </script>
  </body>
</html>
