---
import CanvasExperiment from "../../../../components/lab/CanvasExperiment.astro";
import type { CanvasSettingsTree } from "../../../../components/lab/canvasExperiment";

interface Props {
  src: string;
}

const { src } = Astro.props;
const settings = [
  {
    children: [
      {
        id: "gravity",
        label: "Gravity",
        type: "checkbox",
        value: false
      },
      {
        id: "collisions",
        label: "Collisions",
        type: "checkbox",
        value: false
      }
    ],
    id: "toggles",
    label: "Toggles",
    layout: "row",
    type: "group",
    variant: "plain"
  },
  {
    children: [
      {
        id: "resolution",
        label: "Resolution",
        max: 10,
        min: 2,
        showValue: true,
        step: 1,
        type: "range",
        value: 9
      },
      {
        id: "size",
        label: "Size",
        max: 6,
        min: 1,
        showValue: true,
        step: 1,
        type: "range",
        value: 3
      },
      {
        id: "mouseRadius",
        label: "Force",
        max: 6000,
        min: 500,
        showValue: true,
        step: 100,
        type: "range",
        unit: "px",
        value: 3000
      },
      {
        id: "ease",
        label: "Ease",
        max: 0.06,
        min: 0.005,
        showValue: true,
        step: 0.005,
        type: "range",
        value: 0.01
      },
      {
        id: "friction",
        label: "Friction",
        max: 0.98,
        min: 0.75,
        showValue: true,
        step: 0.01,
        type: "range",
        value: 0.86
      }
    ],
    id: "particle-controls",
    label: "Particle controls",
    layout: "row",
    type: "group",
    variant: "plain"
  }
] satisfies CanvasSettingsTree;
---

<CanvasExperiment
  ariaLabel="Interactive particle image"
  fallback={false}
  imageSrc={src}
  script="/src/content/experiments/physics-simulation-javascript/sketches/physics.ts"
  settings={settings}
/>
